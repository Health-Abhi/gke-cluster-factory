# Local mode writes requests into ./requests.
FACTORY_STORAGE_MODE=local
FACTORY_LOG_LEVEL=INFO
FACTORY_ALLOWED_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
FACTORY_ENABLE_LOCAL_PROVISIONING=true
FACTORY_TERRAFORM_BINARY=terraform
FACTORY_GCLOUD_BINARY=gcloud
FACTORY_TF_STATE_BUCKET=your-tf-state-bucket
FACTORY_GKE_SECURITY_GROUP=you@gmail.com
FACTORY_PLATFORM_ADMIN_GROUP=you@gmail.com
FACTORY_IAM_PRINCIPAL_TYPE=user
FACTORY_ENABLE_GOOGLE_GROUPS_RBAC=false
# Optional API authentication. Leave empty for local development.
FACTORY_API_TOKEN=

# GitHub mode opens a pull request instead of writing directly to disk.
# FACTORY_STORAGE_MODE=github
# FACTORY_GITHUB_TOKEN=github_pat_replace_me
# FACTORY_GITHUB_OWNER=your-org
# FACTORY_GITHUB_REPOSITORY=gke-cluster-factory
# FACTORY_GITHUB_DEFAULT_BRANCH=main

# Docker Compose on Linux: set these to `id -u` and `id -g` when using the bind-mounted requests directory.
LOCAL_UID=10001
LOCAL_GID=10001

# Local provisioning: lets the portal's "Provision" button run Terraform apply
# directly on this machine (an alternative to the GitHub Actions pipeline, for
# local/demo use only). Requires terraform and gcloud on PATH, and gcloud to
# already be authenticated (gcloud auth application-default login).
# FACTORY_ENABLE_LOCAL_PROVISIONING=true
# FACTORY_TERRAFORM_BINARY=terraform
# FACTORY_GCLOUD_BINARY=gcloud
# FACTORY_TF_STATE_BUCKET=your-tf-state-bucket
# FACTORY_GKE_SECURITY_GROUP=you@example.com
# FACTORY_PLATFORM_ADMIN_GROUP=you@example.com
# Set both of these to true/user if this is a personal Gmail project with no
# Cloud Identity / Workspace org (Google Groups RBAC needs a real org):
# FACTORY_IAM_PRINCIPAL_TYPE=user
# FACTORY_ENABLE_GOOGLE_GROUPS_RBAC=false
# FACTORY_CREATE_CLUSTER_PROJECTS=false
# FACTORY_CLUSTER_PROJECT_PARENT=
# FACTORY_BILLING_ACCOUNT=
# FACTORY_SKIP_PREFLIGHT=false
